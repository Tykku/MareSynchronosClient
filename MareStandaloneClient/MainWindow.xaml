<Window x:Class="MareStandaloneClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mare Standalone Client" Height="620" Width="740"
        MinHeight="480" MinWidth="520"
        Closing="Window_Closing">
    <DockPanel Margin="10">

        <!-- Configuration -->
        <GroupBox DockPanel.Dock="Top" Header="Configuration" Margin="0,0,0,6" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Config:"
                           VerticalAlignment="Center" Margin="0,3,12,3"/>
                <TextBlock x:Name="ConfigPathText" Grid.Row="0" Grid.Column="1"
                           VerticalAlignment="Center" Margin="0,3"
                           TextTrimming="CharacterEllipsis"
                           FontFamily="Consolas" FontSize="11" Foreground="Gray"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Server:"
                           VerticalAlignment="Center" Margin="0,3,12,3"/>
                <TextBlock x:Name="ServerText" Grid.Row="1" Grid.Column="1"
                           VerticalAlignment="Center" Margin="0,3"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Character:"
                           VerticalAlignment="Center" Margin="0,3,12,3"/>
                <ComboBox x:Name="CharacterCombo" Grid.Row="2" Grid.Column="1" Margin="0,3"/>
            </Grid>
        </GroupBox>

        <!-- Download section (enabled while connected) -->
        <GroupBox DockPanel.Dock="Top" Header="Download Files" Margin="0,0,0,6" Padding="8,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="File Hashes (one per line):" Margin="0,0,0,4"/>

                <TextBox x:Name="HashesBox" Grid.Row="1"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11"/>

                <DockPanel Grid.Row="2" Margin="0,6,0,0">
                    <TextBlock Text="Output Dir:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="DownloadButton" DockPanel.Dock="Right" Content="Download Files"
                            Width="110" Margin="8,0,0,0" IsEnabled="False" Click="Download_Click"/>
                    <Button DockPanel.Dock="Right" Content="Browse..." Width="75"
                            Margin="8,0,0,0" Click="BrowseOutput_Click"/>
                    <TextBox x:Name="OutputDirBox" Text="downloads" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </GroupBox>

        <!-- Buttons + status bar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button x:Name="ConnectButton" Content="Connect" Width="90"
                    Margin="0,0,8,0" Click="Connect_Click"/>
            <Button x:Name="DisconnectButton" Content="Disconnect" Width="90"
                    Margin="0,0,8,0" IsEnabled="False" Click="Disconnect_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Text="Not connected" Foreground="Gray"/>
        </DockPanel>

        <!-- Log (fills remaining space) -->
        <GroupBox Header="Log" Margin="0,6,0,0">
            <TextBox x:Name="LogBox" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11"
                     Background="#1E1E1E" Foreground="#DCDCDC"
                     BorderThickness="0" Padding="4"
                     TextWrapping="NoWrap"/>
        </GroupBox>

    </DockPanel>
</Window>
